{
  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "example": {
          "max_tokens": 64,
          "messages": [
            {
              "content": "Hello, Atlas.",
              "role": "user"
            }
          ],
          "model": "mock",
          "stream": false,
          "temperature": 0.2
        },
        "properties": {
          "max_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cap on generated tokens. `None` defers to the provider default.",
            "title": "Max Tokens"
          },
          "messages": {
            "description": "Ordered conversation messages.",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "title": "Messages",
            "type": "array"
          },
          "model": {
            "description": "Provider model id or Atlas alias (resolved via `app.providers.registry`).",
            "title": "Model",
            "type": "string"
          },
          "prompt_params": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Template params for `prompt_ref` rendering.",
            "title": "Prompt Params"
          },
          "prompt_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional prompt-registry reference `<name>@<semver|production>` (REG-4). Resolved + rendered server-side and prepended as a system message. `None` (default) leaves the request unchanged.",
            "title": "Prompt Ref"
          },
          "stream": {
            "default": false,
            "description": "When `true`, response is `text/event-stream` carrying `chat.completion.chunk` deltas terminated by `data: [DONE]`.",
            "title": "Stream",
            "type": "boolean"
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Sampling temperature in `[0, 2]`. `None` defers to the provider default.",
            "title": "Temperature"
          }
        },
        "required": [
          "model",
          "messages"
        ],
        "title": "ChatCompletionRequest",
        "type": "object"
      },
      "ChatMessage": {
        "example": {
          "content": "Hello, Atlas.",
          "role": "user"
        },
        "properties": {
          "content": {
            "description": "Message content (plain text).",
            "title": "Content",
            "type": "string"
          },
          "role": {
            "description": "Conversation role. One of `system`, `user`, `assistant`, `tool`.",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage",
        "type": "object"
      },
      "EmbeddingData": {
        "properties": {
          "embedding": {
            "description": "Dense vector for this input.",
            "items": {
              "type": "number"
            },
            "title": "Embedding",
            "type": "array"
          },
          "index": {
            "description": "Position in the input batch.",
            "title": "Index",
            "type": "integer"
          },
          "object": {
            "default": "embedding",
            "description": "Always `embedding`.",
            "title": "Object",
            "type": "string"
          }
        },
        "required": [
          "index",
          "embedding"
        ],
        "title": "EmbeddingData",
        "type": "object"
      },
      "EmbeddingRequest": {
        "example": {
          "input": "Hello, Atlas.",
          "model": "mock"
        },
        "properties": {
          "input": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ],
            "description": "One string or a batch of strings to embed.",
            "title": "Input"
          },
          "model": {
            "description": "Provider model id or Atlas alias.",
            "title": "Model",
            "type": "string"
          }
        },
        "required": [
          "model",
          "input"
        ],
        "title": "EmbeddingRequest",
        "type": "object"
      },
      "EmbeddingResponse": {
        "example": {
          "data": [
            {
              "embedding": [
                0.01,
                -0.02,
                0.03
              ],
              "index": 0,
              "object": "embedding"
            }
          ],
          "model": "mock",
          "object": "list",
          "usage": {
            "prompt_tokens": 6,
            "total_tokens": 6
          }
        },
        "properties": {
          "data": {
            "description": "One entry per input, in input order.",
            "items": {
              "$ref": "#/components/schemas/EmbeddingData"
            },
            "title": "Data",
            "type": "array"
          },
          "model": {
            "description": "The model that served the request.",
            "title": "Model",
            "type": "string"
          },
          "object": {
            "default": "list",
            "description": "Always `list`.",
            "title": "Object",
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/EmbeddingUsage",
            "description": "Token usage for billing + accounting."
          }
        },
        "required": [
          "data",
          "model",
          "usage"
        ],
        "title": "EmbeddingResponse",
        "type": "object"
      },
      "EmbeddingUsage": {
        "properties": {
          "prompt_tokens": {
            "description": "Tokens consumed across the batch.",
            "title": "Prompt Tokens",
            "type": "integer"
          },
          "total_tokens": {
            "description": "`prompt_tokens` (no generation for embeddings).",
            "title": "Total Tokens",
            "type": "integer"
          }
        },
        "required": [
          "prompt_tokens",
          "total_tokens"
        ],
        "title": "EmbeddingUsage",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "Typed error body for non-2xx responses.\n\nFastAPI's default HTTPException emits `{\"detail\": ...}`. Some paths (rate\nlimit, budget) return a richer body — this envelope is the documented\nsuperset so codegen produces a single typed error model.",
        "example": {
          "code": "unauthorized",
          "detail": "invalid api key"
        },
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional machine-readable error code (provider/guardrail name).",
            "title": "Code"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ],
            "description": "Human-readable error message, or a structured object for guardrail / rate-limit rejections (see per-endpoint response docs).",
            "title": "Detail"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Model": {
        "properties": {
          "id": {
            "description": "Model id or Atlas alias.",
            "title": "Id",
            "type": "string"
          },
          "object": {
            "default": "model",
            "description": "Always `model`.",
            "title": "Object",
            "type": "string"
          },
          "owned_by": {
            "description": "Provider — `openai`, `anthropic`, `google`, `atlas`.",
            "title": "Owned By",
            "type": "string"
          }
        },
        "required": [
          "id",
          "owned_by"
        ],
        "title": "Model",
        "type": "object"
      },
      "ModelList": {
        "example": {
          "data": [
            {
              "id": "mock",
              "object": "model",
              "owned_by": "atlas"
            },
            {
              "id": "gpt-4o-mini",
              "object": "model",
              "owned_by": "openai"
            }
          ],
          "object": "list"
        },
        "properties": {
          "data": {
            "description": "All models advertised by the provider registry.",
            "items": {
              "$ref": "#/components/schemas/Model"
            },
            "title": "Data",
            "type": "array"
          },
          "object": {
            "default": "list",
            "description": "Always `list`.",
            "title": "Object",
            "type": "string"
          }
        },
        "required": [
          "data"
        ],
        "title": "ModelList",
        "type": "object"
      },
      "UsageResponse": {
        "example": {
          "rows": [
            {
              "app": "regdoc-qa",
              "input_tokens": 12345,
              "model": "gpt-4o-mini",
              "output_tokens": 4567,
              "total_cost_usd": "1.2345"
            }
          ],
          "since": "2026-06-01"
        },
        "properties": {
          "rows": {
            "description": "One row per (app, model). Sorted by cost desc.",
            "items": {
              "$ref": "#/components/schemas/UsageRow"
            },
            "title": "Rows",
            "type": "array"
          },
          "since": {
            "description": "Inclusive start of the aggregation window (UTC date).",
            "format": "date",
            "title": "Since",
            "type": "string"
          }
        },
        "required": [
          "since",
          "rows"
        ],
        "title": "UsageResponse",
        "type": "object"
      },
      "UsageRow": {
        "properties": {
          "app": {
            "description": "Calling app id (per-API-key label).",
            "title": "App",
            "type": "string"
          },
          "input_tokens": {
            "description": "Sum of prompt tokens over the window.",
            "title": "Input Tokens",
            "type": "integer"
          },
          "model": {
            "description": "Provider model id or Atlas alias served.",
            "title": "Model",
            "type": "string"
          },
          "output_tokens": {
            "description": "Sum of completion tokens over the window.",
            "title": "Output Tokens",
            "type": "integer"
          },
          "total_cost_usd": {
            "description": "Sum of `computed_cost_usd` (USD).",
            "title": "Total Cost Usd",
            "type": "string"
          }
        },
        "required": [
          "app",
          "model",
          "input_tokens",
          "output_tokens",
          "total_cost_usd"
        ],
        "title": "UsageRow",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "Atlas API key",
        "description": "Atlas API key sent as `Authorization: Bearer <key>`. Local dev default is `dev-key`; real deployments source keys from Key Vault.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "email": "contact@bragdev.com",
      "name": "Bruno Braga"
    },
    "description": "The **Atlas Gateway** is the single OpenAI-compatible facade in front of\nOpenAI, Anthropic, and Google. Every LLM call from the frontend and the agent\nruntime flows through here so prompts are versionable, guardrails enforceable,\nand every call cost-traceable (ADR-014).\n\n### Authentication\nAll `/v1/*` endpoints require `Authorization: Bearer <key>`. Local dev keys\ncome from `ATLAS_API_KEYS` (default `[\"dev-key\"]`); real deployments source\nkeys from Key Vault.\n\n### Streaming\n`POST /v1/chat/completions` with `\"stream\": true` returns\n`text/event-stream` carrying OpenAI `chat.completion.chunk` deltas terminated\nby `data: [DONE]`.\n\n### Errors\n4xx/5xx responses use the `ErrorEnvelope` schema (`{detail, code?}`).\nPer-endpoint codes are documented under each operation's responses.\n",
    "license": {
      "name": "Internal — Atlas (Enhesa mirror)"
    },
    "title": "Atlas Gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Returns `{\"status\": \"ok\"}`. No dependencies; safe to poll.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/chat/completions": {
      "post": {
        "description": "OpenAI-compatible chat completion. Set `stream: true` to receive a `text/event-stream` of `chat.completion.chunk` deltas instead of a single JSON response. Honors guardrails (GRD-*), rate limits (GW-16), monthly budgets (GW-17), and the prompt registry (REG-4).",
        "operationId": "chat_completions_v1_chat_completions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              },
              "text/event-stream": {
                "example": "data: {\"id\":\"chatcmpl-1\",\"object\":\"chat.completion.chunk\",\"created\":1735689600,\"model\":\"mock\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\"}}]}\n\ndata: {\"id\":\"chatcmpl-1\",\"object\":\"chat.completion.chunk\",\"created\":1735689600,\"model\":\"mock\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hi\"}}]}\n\ndata: [DONE]\n\n",
                "schema": {
                  "description": "Server-Sent Events. Each line `data: {json}` carries a `ChatCompletionChunk`. Terminator: `data: [DONE]`.",
                  "type": "string"
                }
              }
            },
            "description": "Chat completion (JSON) or SSE stream of `chat.completion.chunk` deltas."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid Bearer key."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unknown model — no provider/alias matched."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Guardrail rejection. `detail` is `{guardrail, phase, reason}` naming the check and pipeline phase that rejected the request."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Rate limit or monthly budget exceeded. Response carries `Retry-After` (seconds). Body shape matches atlas-docs/03 §5.2."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Create a chat completion",
        "tags": [
          "chat"
        ]
      }
    },
    "/v1/embeddings": {
      "post": {
        "description": "OpenAI-compatible embeddings. `input` may be a single string or a batch; the response preserves input order.",
        "operationId": "embeddings_v1_embeddings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmbeddingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid Bearer key."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unknown model — no provider/alias matched."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Create embeddings",
        "tags": [
          "embeddings"
        ]
      }
    },
    "/v1/models": {
      "get": {
        "description": "OpenAI-compatible model list. Aggregates every model id/alias advertised by the provider registry (OpenAI + Anthropic + Google + Atlas Mock).",
        "operationId": "list_models_v1_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid Bearer key."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List available models",
        "tags": [
          "models"
        ]
      }
    },
    "/v1/usage": {
      "get": {
        "description": "Token + cost aggregates from `call_records`, grouped by (app, model) and sorted by total cost desc. Default window: current calendar month. Requires `ATLAS_DB_URL`; returns 503 when accounting DB is not configured.",
        "operationId": "get_usage_v1_usage_get",
        "parameters": [
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid Bearer key."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Accounting DB not configured (`ATLAS_DB_URL` unset)."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Per-(app, model) usage aggregates",
        "tags": [
          "usage"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Local debug (VS Code launcher)",
      "url": "http://localhost:8090"
    },
    {
      "description": "In-cluster (AKS)",
      "url": "http://atlas-gateway.atlas-platform.svc:8000"
    }
  ],
  "tags": [
    {
      "description": "OpenAI-compatible chat completions (non-streaming JSON + SSE stream). Honors guardrails, rate limits, and budget; emits cost events to Kafka via the accounting recorder.",
      "name": "chat"
    },
    {
      "description": "OpenAI-compatible embeddings. Returns a list of 1+ embedding vectors matching the order of the input.",
      "name": "embeddings"
    },
    {
      "description": "OpenAI-compatible model list. Aggregated from the provider registry.",
      "name": "models"
    },
    {
      "description": "Per-(app, model) token + cost aggregates over a date window. Requires `ATLAS_DB_URL`; returns 503 when the accounting DB is not configured.",
      "name": "usage"
    },
    {
      "description": "Liveness probe. Used by Kubernetes and the local-compose stack.",
      "name": "health"
    }
  ]
}
